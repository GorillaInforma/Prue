# Railway te da esto automáticamente al agregar el plugin de PostgreSQL
# (Add Service > Database > PostgreSQL). Cópiala del tab "Variables".
DATABASE_URL="postgresql://usuario:password@host:5432/railway"

# URL pública de tu servicio Next.js una vez desplegado en Railway
# (la ves en Settings > Networking > Generate Domain)
COBRANZA_API_URL="https://tu-servicio.up.railway.app"

# --- Integraciones reales (opcional, ver lib/integraciones.ts) ---
# PAC_API_KEY=""
# STRIPE_SECRET_KEY=""
# WHATSAPP_TOKEN=""
